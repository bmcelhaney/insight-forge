# Insight Forge Environment Variables
IF_ENV=development
IF_PORT=8080
IF_DUCKDB_PATH=./data/insight-forge.duckdb
IF_LOG_LEVEL=info

# Optional dotenv files loaded at startup (if present), without overriding real env:
#   .env
#   .env.partsbase   <-- recommended for PartsBase OAuth secrets (gitignored)
#   .env.local
#
# Add source-specific credentials here as needed (never commit real keys)
# WEBFLIS_API_KEY=
# FPDS_API_KEY=
# IF_PARTSBASE_ENABLED=true
# IF_PARTSBASE_CLIENT_ID=
# IF_PARTSBASE_CLIENT_SECRET=
# IF_PARTSBASE_USERNAME=
# IF_PARTSBASE_PASSWORD=
# IF_PARTSBASE_AUTH_URL=https://auth.partsbase.com/connect/token
# IF_PARTSBASE_BASE_URL=https://apiservices.partsbase.com
# IF_PARTSBASE_GOVDATA_PATH=/api/data/GovData
# IF_PARTSBASE_GOVDATA_TYPE=Nsn
# IF_PARTSBASE_GOVDATA_START_DATE=2000-01-01
# IF_PARTSBASE_GOVDATA_SECTIONS=Procurement,NsnId
# IF_PARTSBASE_OAUTH_GRANT_TYPE=password
# IF_PARTSBASE_OAUTH_SCOPE=api
# IF_PARTSBASE_TIMEOUT_SECONDS=30
#
# SerpAPI (Google Shopping) — commercial deep links + market price ranges
# Prefer a gitignored file:
#   .env.serpapi   with IF_SERPAPI_KEY=...
# IF_SERPAPI_KEY=
# IF_SERPAPI_ENABLED=true
# IF_SERPAPI_NUM=8
# P2 Immersive Product: multi-store prices (extra SerpAPI credit per product).
# Default true for API + UI when client omits serp_immersive.
# Set false to default shopping-search-only (less quota burn):
# IF_SERPAPI_IMMERSIVE=false
# Per-request override (POST /api/analyze or /api/insight):
#   {"nsn":"...","serp_immersive":false}
# Quota burn panel: GET /api/quotas  (SerpAPI Account API is free)
#
# Product-link live verification (HEAD/GET + soft-404 sniff, cached).
# Default on. Set false to skip probes (structural checks only):
# IF_LINK_VERIFY=false
#
# Tigris (S3) — pricing evidence screenshots of links.url
# Prefer gitignored .env.tigris (never commit secrets):
#   IF_TIGRIS_ENABLED=true
#   IF_TIGRIS_BUCKET=fair-market-pricing
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_ENDPOINT_URL_S3=https://t3.storage.dev
#   AWS_REGION=auto
# IF_SCREENSHOT_ENABLED=true
# IF_SCREENSHOT_MAX_PER_RUN=8
# IF_SCREENSHOT_TIMEOUT_MS=20000
# Backend: thum (default, HTTP API — recommended) | microlink | chrome (legacy local browser)
# IF_SCREENSHOT_BACKEND=thum
# Optional thum.io auth for higher rate limits: IF_THUM_AUTH=...
# Screenshots default ON when Tigris is configured.
# Opt out per request: {"capture_screenshots":false} or ?capture_screenshots=false
# Or force always-on/off server-wide: IF_SCREENSHOT_ON_ANALYZE=true|false
# Captures are async — poll GET /api/proofs/{analysis_id}
# Legacy only: IF_CHROME_PATH=/path/to/chrome
#
# UPCItemDB paid DEV/PRO — product identity + merchant offers
# Prefer a gitignored file:
#   .env.upcitemdb   with IF_UPCITEMDB_KEY=...
# IF_UPCITEMDB_KEY=
# IF_UPCITEMDB_ENABLED=true
