# Insight Forge Environment Variables
IF_ENV=development
IF_PORT=8080
IF_DUCKDB_PATH=./data/insight-forge.duckdb
IF_LOG_LEVEL=info

# Optional dotenv files loaded at startup (if present), without overriding real env:
#   .env
#   .env.partsbase   <-- recommended for PartsBase OAuth secrets (gitignored)
#   .env.local
#
# Add source-specific credentials here as needed (never commit real keys)
# WEBFLIS_API_KEY=
# FPDS_API_KEY=
# IF_PARTSBASE_ENABLED=true
# IF_PARTSBASE_CLIENT_ID=
# IF_PARTSBASE_CLIENT_SECRET=
# IF_PARTSBASE_USERNAME=
# IF_PARTSBASE_PASSWORD=
# IF_PARTSBASE_AUTH_URL=https://auth.partsbase.com/connect/token
# IF_PARTSBASE_BASE_URL=https://apiservices.partsbase.com
# IF_PARTSBASE_GOVDATA_PATH=/api/data/GovData
# IF_PARTSBASE_GOVDATA_TYPE=Nsn
# IF_PARTSBASE_GOVDATA_START_DATE=2000-01-01
# IF_PARTSBASE_GOVDATA_SECTIONS=Procurement,NsnId
# IF_PARTSBASE_OAUTH_GRANT_TYPE=password
# IF_PARTSBASE_OAUTH_SCOPE=api
# IF_PARTSBASE_TIMEOUT_SECONDS=30
#
# SerpAPI (Google Shopping) — commercial deep links + market price ranges
# Prefer a gitignored file:
#   .env.serpapi   with IF_SERPAPI_KEY=...
# IF_SERPAPI_KEY=
# IF_SERPAPI_ENABLED=true
# IF_SERPAPI_NUM=8
# P2 Immersive Product: multi-store prices (extra SerpAPI credit per product).
# Default true. Set false to restore shopping-search-only (less quota burn):
# IF_SERPAPI_IMMERSIVE=false
#
# UPCItemDB paid DEV/PRO — product identity + merchant offers
# Prefer a gitignored file:
#   .env.upcitemdb   with IF_UPCITEMDB_KEY=...
# IF_UPCITEMDB_KEY=
# IF_UPCITEMDB_ENABLED=true
